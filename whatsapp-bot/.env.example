# Copie este ficheiro para ".env" e preencha antes de rodar o robô.

# Mesmos valores do site principal (Settings -> Data API no painel do Supabase)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Settings -> Data API -> service_role (secreta! nunca partilhar nem colocar no frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Uma senha inventada por você, só pra o worker (Edge Function processar-fila)
# conseguir chamar o /enviar. Tem de ser IGUAL ao secret BOT_SECRET que você
# definir na Edge Function.
BOT_SECRET=

# Porta onde o robô vai escutar (a maioria dos hosts define isto sozinha)
PORT=3333
