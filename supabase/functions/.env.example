# Segredos das Edge Functions — WhatsApp Cloud API.
# VALORES FICTÍCIOS. Os reais vão para Supabase Secrets:
#   supabase secrets set --env-file ./supabase/functions/.env   (ficheiro local, NUNCA no Git)
# Nunca usar o prefixo VITE_ para estes valores: tudo o que começa por VITE_ vai para o browser.

# --- Credenciais da Meta -------------------------------------------------------
# Token de Utilizador do Sistema (Business Manager > Utilizadores do sistema),
# com whatsapp_business_messaging + whatsapp_business_management.
WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_PHONE_NUMBER_ID=000000000000000
WA_WABA_ID=000000000000000
# App Secret (developers.facebook.com > App > Definições > Básico). Valida o webhook.
WA_APP_SECRET=0123456789abcdef0123456789abcdef
# Texto aleatório escolhido por ti, igual ao do painel de Webhooks. Ex.: openssl rand -hex 24
WA_VERIFY_TOKEN=troca-isto-por-um-valor-aleatorio
# Versão da Graph API (v26.0 é a mais recente no changelog oficial a 11/11/2026).
WA_GRAPH_API_VERSION=v26.0
# Opcional: timeout do pedido à Meta em ms (1000–30000).
WA_TIMEOUT_MS=10000

# Pepper para o hash HMAC dos telefones (opt-out global e limites). Mínimo 32
# caracteres; NUNCA mudar depois de haver bloqueios (os hashes deixariam de bater).
# Ex.: openssl rand -hex 32
WA_TELEFONE_PEPPER=troca-isto-por-64-caracteres-hex-aleatorios-0000000000000000

# --- Worker processar-whatsapp-cloud ------------------------------------------------
# Segredo PRÓPRIO do cron novo (diferente do CRON_SECRET atual). Mínimo 24 caracteres.
WA_CRON_SECRET=troca-isto-por-um-segredo-aleatorio-longo
# Interruptor geral: o worker só processa com "true".
WA_CLOUD_WORKER_ATIVO=false
# Opcionais: linhas por execução e tempo máximo de uma execução (ms).
WA_LOTE=20
WA_PRAZO_MS=40000

# --- Função testar-whatsapp-cloud ---------------------------------------------------
# IDs (auth.users.id) de quem pode usar a função de teste, separados por vírgulas.
WA_TEST_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
# Números autorizados para testes (E.164), separados por vírgulas. Com o número de
# teste da Meta, têm de estar também na lista de destinatários do painel "API Setup".
WA_TEST_DESTINATARIOS=+351900000000
# Envio real só com este valor a "true" E {"confirmar_envio_real": true} no pedido.
WA_TEST_ENVIO_REAL_PERMITIDO=false
